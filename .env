# =============================================================================
# FIX4HOME - DOCKER COMPOSE ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update with your actual values
# cp environment.template .env
#
# NOTE: Email service (.microservice/MRS_SENDEMAIL_BE) uses its own .env file
# which is mounted into the container. SMTP credentials and API keys are
# configured in .microservice/MRS_SENDEMAIL_BE/.env, not here.
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_NAME=fix4home_db
DB_USER=fix4home
DB_PASSWORD=pass123
DB_PORT=3307

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
APP_PORT=8100
JWT_SECRET=fix4home-production-jwt-secret-key-2024-very-secure-and-long
ADMIN_REGISTRATION_KEY=FIX4HOME_ADMIN_SECRET_PRODUCTION_2024

# Email Service API Key (for Spring Boot app to call email service)
# IMPORTANT: This must match one of the API keys in .microservice/MRS_SENDEMAIL_BE/.env
# The API key should be included in the API_KEYS list in microservice .env file
EMAIL_VERIFICATION_API_KEY=fix4home_prod_123abc456def789

# =============================================================================
# SSL CONFIGURATION
# =============================================================================
SSL_ENABLED=false

# =============================================================================
# MONITORING (OPTIONAL)
# =============================================================================
GRAFANA_PASSWORD=admin