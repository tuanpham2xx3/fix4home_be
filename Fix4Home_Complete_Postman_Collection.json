								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/customers/addresses",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers", "addresses"]
						},
						"description": "Get all customer addresses"
					}
				},
				{
					"name": "Create Address",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Address creation successful', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response contains address ID', function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response.data).to.have.property('id');",
									"    ",
									"    if (response.data && response.data.id) {",
									"        pm.collectionVariables.set('addressId', response.data.id);",
									"    }",
									"});",
									"",
									"pm.test('Address data is correct', function () {",
									"    const response = pm.response.json();",
									"    const address = response.data;",
									"    pm.expect(address.street).to.eql('123 Main Street');",
									"    pm.expect(address.city).to.eql('Ho Chi Minh City');",
									"    pm.expect(address.isDefault).to.be.true;",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"street\": \"123 Main Street\",\n    \"city\": \"Ho Chi Minh City\",\n    \"state\": \"Ho Chi Minh\",\n    \"zipCode\": \"70000\",\n    \"country\": \"Vietnam\",\n    \"isDefault\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/customers/addresses",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers", "addresses"]
						},
						"description": "Create a new customer address"
					}
				},
				{
					"name": "Update Address",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Address update successful', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Updated data is correct', function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response.data.street).to.eql('456 Updated Street');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"street\": \"456 Updated Street\",\n    \"city\": \"Ho Chi Minh City\",\n    \"state\": \"Ho Chi Minh\",\n    \"zipCode\": \"70000\",\n    \"country\": \"Vietnam\",\n    \"isDefault\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/customers/addresses/{{addressId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers", "addresses", "{{addressId}}"]
						},
						"description": "Update existing address"
					}
				}
			]
		}
