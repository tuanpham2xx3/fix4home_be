# Fix4Home Backend Environment Configuration Template
# Copy this file to .env and update with your actual values

# =================
# Database Configuration
# =================
DB_PASSWORD=change_this_password_in_production
DB_NAME=fix4home_db
DB_USER=fix4home_user
DB_PORT=3307
DB_HOST=localhost

# =================
# Application Security
# =================
JWT_SECRET=change_this_to_a_very_long_and_secure_secret_key_for_production
ADMIN_REGISTRATION_KEY=change_this_admin_secret_key
COOKIE_DOMAIN=localhost

# =================
# SSL Configuration
# =================
SSL_ENABLED=false
SSL_KEYSTORE=classpath:keystore.p12
SSL_PASSWORD=change_this_ssl_password

# =================
# Redis Configuration
# =================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# =================
# File Storage
# =================
FILE_STORAGE_TYPE=local
FILE_STORAGE_LOCAL_BASE_URL=http://localhost:8100/api/v1/files/

# AWS S3 Configuration (if using cloud storage)
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=fix4home-files

# =================
# External Services
# =================
# Email Verification Service
EMAIL_VERIFICATION_SERVICE_URL=http://localhost:8200
EMAIL_VERIFICATION_API_KEY=fix4home_prod_123abc456def789

# Vietnam Address API
VIETNAM_ADDRESS_API_URL=http://localhost:8080/api/v1

# =================
# Push Notifications
# =================
FCM_SERVICE_ACCOUNT_KEY=src/main/resources/firebase-service-account.json
FCM_PROJECT_ID=fix4home-app
APNS_CERTIFICATE_PATH=src/main/resources/apns-certificate.p12
APNS_CERTIFICATE_PASSWORD=
APNS_PRODUCTION=false

# =================
# Monitoring & Logging
# =================
# Sentry Error Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Grafana
GRAFANA_PASSWORD=admin

# =================
# Database Backup
# =================
DB_BACKUP_ENABLED=true
DB_BACKUP_CRON=0 0 2 * * ?
DB_BACKUP_RETENTION_DAYS=30
DB_BACKUP_LOCATION=backup/database/
DB_BACKUP_COMPRESS=true
DB_BACKUP_NOTIFICATION=true
DB_BACKUP_EMAIL=admin@fix4home.com

# =================
# Docker & Deployment
# =================
APP_PORT=8100
HOSTNAME=fix4home-server

# =================
# Development Only
# =================
DB_SHOW_SQL=false
