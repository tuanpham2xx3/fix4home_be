# Docker ignore file for Fix4Home Backend

# Target directory
target/
!target/*.jar

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Maven
.mvn/wrapper/maven-wrapper.jar

# Git
.git/
.gitignore

# Logs
logs/
*.log

# Temporary files
*.tmp
*.temp

# Documentation
docs/
*.md
!README.md

# Test files
src/test/

# IDE configurations
.settings/
.project
.classpath

# Environment files
.env
.env.local
.env.production

# Upload directory
uploads/

# Backup files
backup/

# Docker files in root (to avoid recursion)
Dockerfile
docker-compose*.yml
.dockerignore
